    const lab = document.createElement('label'); lab.className='toggle';
    lab.innerHTML = '<input type="checkbox"> Síntomas '+esc(g.toLowerCase());
    const cb = lab.querySelector('input'); cb.checked = open;
    cb.onchange = () => {
      if (cb.checked){ if (!st.gOpen.includes(g)) st.gOpen.push(g); }
      else { st.gOpen = st.gOpen.filter(x=>x!==g); st.sint = st.sint.filter(s=>!items.includes(s.name)); }
      sync();
    };
    w.appendChild(lab);
    if (open) items.forEach(n => w.appendChild(symRow(n,false)));
    box.appendChild(w);
  });
