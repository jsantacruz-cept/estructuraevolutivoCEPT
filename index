/* Constructores de controles */
function seg(el, opts, getter, setter){
  el.innerHTML = '';
  opts.forEach(([v,l]) => {
    const b = document.createElement('button'); b.type='button'; b.textContent=l;
    b.setAttribute('aria-pressed', getter()===v);
    b.onclick = () => { setter(getter()===v ? null : v); sync(); };
    el.appendChild(b);
  });
}
function chips(el, opts, arr, onChange, cls){
  el.innerHTML='';
  opts.forEach(o => {
    const v = typeof o==='string'? o : o.id, l = typeof o==='string'? cap(o) : o.label;
    const b = document.createElement('button'); b.type='button'; b.className='chip';
    b.textContent=l; b.setAttribute('aria-pressed', arr.includes(v));
    b.onclick = () => { onChange(v); sync(); };
    el.appendChild(b);
  });
}
const toggleIn = (arr, v) => { const i=arr.indexOf(v); i>=0 ? arr.splice(i,1) : arr.push(v); };

function symRow(name, custom){
  const s = st.sint.find(x=>x.name===name);
  const r = document.createElement('div'); r.className='srow';
  const n = document.createElement('span'); n.className='sname'; n.textContent=cap(name); r.appendChild(n);
  const sg = document.createElement('div'); sg.className='seg small'; sg.setAttribute('role','group'); sg.setAttribute('aria-label','Evolución de '+name);
  TEND.forEach(([v,l]) => {
    const b=document.createElement('button'); b.type='button'; b.textContent=l;
    b.setAttribute('aria-pressed', !!s && s.tend===v);
    b.onclick=()=>{
      if (!s) st.sint.push({name, tend:v, ctx:[], showCtx:false});
      else if (s.tend===v){ if (custom) s.tend=null; else st.sint.splice(st.sint.indexOf(s),1); }
      else s.tend=v;
      sync();
    };
    sg.appendChild(b);
  });
  r.appendChild(sg);
  if (s){
    const t=document.createElement('button'); t.type='button'; t.className='x';
    t.textContent = s.showCtx ? 'Ocultar contexto' : (s.ctx.length ? 'Contexto ('+s.ctx.length+')' : 'Agregar contexto');
    t.onclick=()=>{ s.showCtx=!s.showCtx; sync(); }; r.appendChild(t);
    if (custom){ const q=document.createElement('button'); q.type='button'; q.className='x'; q.textContent='Quitar';
      q.onclick=()=>{ st.sint.splice(st.sint.indexOf(s),1); sync(); }; r.appendChild(q); }
    if (s.showCtx){
      const c=document.createElement('div'); c.className='chips ctxs';
      CONTEXTOS.forEach(ctx => {
        const b=document.createElement('button'); b.type='button'; b.className='chip'; b.textContent=cap(ctx);
        b.setAttribute('aria-pressed', s.ctx.includes(ctx));
        b.onclick=()=>{ toggleIn(s.ctx, ctx); sync(); }; c.appendChild(b);
      });
      r.appendChild(c);
    }
  }
  return r;
}
