/* Variantes de redacción: se fijan al elegir el dato y cambian con "Otra redacción" */
function pick(key, arr){
  const r = st.vr[key];
  if (!r || r.n !== arr.length) st.vr[key] = {i: Math.floor(Math.random()*arr.length), n: arr.length};
  return arr[st.vr[key].i];
}
function reroll(){
  Object.values(st.vr).forEach(r => { if (r.n > 1){ let j; do { j = Math.floor(Math.random()*r.n); } while (j === r.i); r.i = j; } });
}

/* Generación del texto */
function build(){
  const r = {estable:$('r-estable').checked, apoyo:$('r-apoyo').checked, present:$('r-present').checked};
  const pend = [];
  const p0 = [], p1 = [], p2 = [];

  // Presentación
  if (st.modal || st.punct) p0.push(pick('asist:'+(st.modal||'')+':'+(st.punct||''), ASIST_V[(st.modal||'')+':'+(st.punct||'')]));
  if (st.actitud.length) p0.push(pick('actitud', ACTITUD_V)(joinY(st.actitud)));
  if (st.eCurso) p0.push(pick('curso:'+st.eCurso, ESTADO_V['curso:'+st.eCurso]));
  if (st.eAsoc) p0.push(pick('asoc', ESTADO_V.asoc));
  if (st.eDirectriz) p0.push(pick('directriz:'+st.eDirectriz, ESTADO_V['directriz:'+st.eDirectriz]));
  if (st.eSenso) p0.push(pick('senso:'+st.eSenso, ESTADO_V['senso:'+st.eSenso]));
  if (!p0.length && r.present){ p0.push(M('presentación observada')); pend.push('Registrar la presentación observada en sesión.'); }

  // Estado global
  if (!st.global){ /* opcional */ }
  else if (st.global==='estable'){
    p1.push(pick('global:estable', GLOBAL_V.estable));
    if (st.sinCambios) p1.push(pick('sincambios', SINCAMBIOS_V));
  } else {
    const mag = st.mag ? (st.global==='favorable' ? st.mag : {leve:'leve',moderada:'moderado',marcada:'marcado'}[st.mag]) : M('magnitud');
    if (!st.mag) pend.push('Indicar la magnitud del cambio.');
    p1.push(pick('global:'+st.global, GLOBAL_V[st.global])(mag));
  }

  // Síntomas
  const sintExento = st.global==='estable' && st.sinCambios;
  if (st.sint.length){
    const groups = {};
    st.sint.forEach(s => {
      const k = s.tend || '_';
      (groups[k] = groups[k] || []).push(esc(s.name) + (s.ctx.length ? ' ' + joinY(s.ctx) : ''));
      if (!s.tend) pend.push(`Indicar cómo evolucionó: ${s.name}.`);
    });
    ['mejoria','persiste','empeora'].forEach(k => { if (groups[k]) p1.push(pick('tend:'+k, TEND_V[k])(groups[k]) + '.'); });
    if (groups._) p1.push(`Refiere ${M('evolución')} ${deList(groups._)}.`);
  } else if (!sintExento){
    p1.push(M('síntomas referidos')); pend.push('Elegir al menos un síntoma referido, o marcar “Estable” sin cambios significativos.');
  }
  if (st.avOn) st.phAv.forEach(id => { const d = PH_AV.find(x=>x.id===id); p1.push(pick('av:'+id, d.v)); });
  if (st.sintLibre.trim()) p1.push(esc(st.sintLibre.trim().replace(/\.?$/,'.')));

  // Tarea pactada
  if (st.tareaOn){
    const labels = INTERV.filter(d=>st.tItems.includes(d.id)).map(d=>d.label.toLowerCase().replace(' / ','/'));
    if (!labels.length) pend.push('Indicar cuál era la tarea pactada.');
    const base = labels.length>1 ? `las tareas pactadas (${joinY(labels)})` : `la tarea pactada (${labels[0] || M('tarea pactada')})`;
    let s;
    if (st.tGrado) s = pick('grado:'+st.tGrado, GRADO_V[st.tGrado])(base);
    else { s = `${M('cumplimiento')} ${base}`; pend.push('Indicar el cumplimiento de la tarea.'); }
    if (st.tGrado !== 'no'){
      const res = st.tRes ? pick('res:'+st.tRes, RES_V[st.tRes]) : null;
      s += ', ' + (res || M('resultado'));
      if (!res) pend.push('Indicar el resultado de la tarea.');
    } else if (st.tMot.trim()) s += ', por ' + esc(st.tMot.trim());
    p2.push(s + '.');
  }

  // Intervenciones
  let validas = 0;
  INTERV.forEach(def => {
    if (!st.interv.some(x=>x.id===def.id)) return;
    p2.push(pick('int:'+def.id, def.v));
    if (!def.apoyo || r.apoyo) validas++;
  });
  const requiereInt = !(st.global==='estable' && !r.estable);
  if (requiereInt && validas===0){
    if (!st.interv.length) p2.push(M('intervención realizada'));
    pend.push(st.interv.length && !r.apoyo ? 'Con las reglas actuales, el espacio de escucha no alcanza: agregar otra intervención.' : 'Registrar al menos una intervención.');
  }

  // Cierre
  if (st.riesgo==='no') p2.push(pick('riesgo:no', RIESGO_NO_V));
  else if (st.riesgo==='si'){
    const c = st.riesgoC.trim();
    p2.push('Presenta al momento actual ideas de auto/heteroagresión. Conducta adoptada: ' + (c?esc(c):M('conducta adoptada')) + '.');
    if (!c) pend.push('Registrar la conducta adoptada ante el riesgo.');
  }
  if (st.retiro){ const d = PH_RETIRO.find(x=>x.id===st.retiro); p2.push(pick('retiro', RETIRO_V)(d.x)); }

  return {p0, p1, p2, pend};
}
const toHTML = s => s.replace(/\u0001(.*?)\u0002/g, '<mark>[$1]</mark>');
const toPlain = s => s.replace(/\u0001(.*?)\u0002/g, '[$1]').replace(/&amp;/g,'&').replace(/&lt;/g,'<').replace(/&gt;/g,'>').replace(/&quot;/g,'"');

let last, gen = ['','',''];
function renderOut(){
  last = build();
  const parts = [last.p0, last.p1, last.p2];
  parts.forEach((p, i) => {
    const html = p.length ? toHTML(p.join(' ')) : '';
    gen[i] = p.length ? toPlain(p.join(' ')) : '';
    const out = $('out'+i), stale = $('stale'+i);
    $('ed'+i).classList.toggle('hidden', st.edit[i]===null);
    if (st.edit[i]===null){
      if (document.activeElement !== out || out.dataset.html !== html){ out.innerHTML = html; out.dataset.html = html; }
      stale.classList.add('hidden');
    } else if (gen[i] !== st.editBase[i]){
      stale.innerHTML = 'El formulario cambió después de editar esta sección. <button type="button">Regenerar sección</button>';
      stale.querySelector('button').onclick = () => { st.edit[i] = null; renderOut(); };
      stale.classList.remove('hidden');
    } else stale.classList.add('hidden');
  });
  const s = $('status');
  if (!last.pend.length){ s.className='status ok'; s.textContent='Completo según las reglas actuales.'; }
  else {
    s.className='status';
    s.innerHTML = `<strong>${last.pend.length} ${last.pend.length===1?'dato pendiente':'datos pendientes'}</strong><ul>${last.pend.map(p=>`<li>${esc(p)}</li>`).join('')}</ul>`;
  }
  $('copy').disabled = last.pend.length > 0;
  $('restore').disabled = st.edit.every(e => e===null);
}
[0,1,2].forEach(i => {
  const out = $('out'+i);
  out.addEventListener('input', () => {
    if (st.edit[i]===null) st.editBase[i] = gen[i];
    st.edit[i] = (out.innerText !== undefined ? out.innerText : out.textContent).trim();
    renderOut();
  });
  out.addEventListener('paste', e => {
    e.preventDefault();
    const t = (e.clipboardData || window.clipboardData).getData('text/plain');
    document.execCommand('insertText', false, t);
  });
});

function sync(rows){
  seg($('global'), GLOBAL, ()=>st.global, v=>{ st.global=v; if(v==='estable') st.mag=null; else st.sinCambios=false; });
  $('mag-wrap').classList.toggle('hidden', !st.global || st.global==='estable');
  seg($('mag'), MAG, ()=>st.mag, v=>st.mag=v);
  $('sc-wrap').classList.toggle('hidden', st.global!=='estable');
  $('sin-cambios').checked = st.sinCambios;

  chips($('actitud'), ACTITUD, st.actitud, v=>toggleIn(st.actitud,v));
  seg($('e-curso'), E_CURSO, ()=>st.eCurso, v=>st.eCurso=v);
  chips($('e-asoc'), [{id:'asoc',label:'Coherente'}], st.eAsoc?['asoc']:[], ()=>{ st.eAsoc=!st.eAsoc; });
  seg($('e-directriz'), E_SINO, ()=>st.eDirectriz, v=>st.eDirectriz=v);
  seg($('e-senso'), E_SINO, ()=>st.eSenso, v=>st.eSenso=v);

  seg($('modal'), MODAL, ()=>st.modal, v=>st.modal=v);
  seg($('punct'), PUNCT, ()=>st.punct, v=>st.punct=v);
  chips($('ph-av'), PH_AV, st.phAv, v=>toggleIn(st.phAv,v));
  chips($('ph-retiro'), PH_RETIRO, st.retiro?[st.retiro]:[], v=>{ st.retiro = st.retiro===v?null:v; });
  seg($('riesgo'), RIESGO, ()=>st.riesgo, v=>st.riesgo=v);
  $('riesgo-c-wrap').classList.toggle('hidden', st.riesgo!=='si');

  renderSint();

  $('tarea-on').checked = st.tareaOn;
  $('tarea-box').classList.toggle('hidden', !st.tareaOn);
  renderTareas();
  $('av-on').checked = st.avOn;
  $('av-box').classList.toggle('hidden', !st.avOn);
  seg($('t-grado'), T_GRADO, ()=>st.tGrado, v=>st.tGrado=v);
  $('t-res-wrap').classList.toggle('hidden', st.tGrado==='no');
  $('t-mot-wrap').classList.toggle('hidden', st.tGrado!=='no');
  seg($('t-res'), T_RES, ()=>st.tRes, v=>st.tRes=v);

  renderInt();

  renderOut();
}

/* Campos de texto: actualizan estado sin redibujar el formulario */
const bind = (id, key) => { $(id).addEventListener('input', e => { st[key]=e.target.value; renderOut(); }); };
[['sint-libre','sintLibre'],['t-mot','tMot']].forEach(a=>bind(...a));
$('riesgo-c').addEventListener('input', e => { st.riesgoC=e.target.value; renderOut(); });
function fillInputs(){
  $('riesgo-c').value=st.riesgoC;
  $('sint-libre').value=st.sintLibre; $('t-mot').value=st.tMot;
}
$('sin-cambios').onchange = e => { st.sinCambios = e.target.checked; renderOut(); };
$('tarea-on').onchange = e => { st.tareaOn = e.target.checked; if (!st.tareaOn){ st.tItems=[]; st.tgOpen=[]; st.tGrado=null; st.tRes=null; st.tMot=''; $('t-mot').value=''; } sync(); };
$('av-on').onchange = e => { st.avOn = e.target.checked; if (!st.avOn) st.phAv=[]; sync(); };
['r-estable','r-apoyo','r-present'].forEach(id => $(id).onchange = renderOut);
$('sint-add').onclick = () => {
  const v = $('sint-otro').value.trim().toLowerCase();
  if (v && !st.sint.some(s=>s.name===v)) st.sint.push({name:v, tend:null, ctx:[], showCtx:false, custom:true});
  $('sint-otro').value=''; sync();
};
$('sint-otro').addEventListener('keydown', e => { if (e.key==='Enter'){ e.preventDefault(); $('sint-add').click(); } });

function load(obj){ st = Object.assign(fresh(), obj); fillInputs(); sync(); }
$('reset').onclick = () => load({});
$('reroll').onclick = () => {
  reroll(); renderOut();
  const ed = st.edit.some(e => e!==null);
  $('toast').textContent = ed ? 'Nueva redacción generada. Las secciones editadas no se modificaron.' : 'Nueva redacción generada';
  setTimeout(()=>$('toast').textContent='', 3000);
};
$('restore').onclick = () => { st.edit = [null,null,null]; renderOut(); };
try { $('prev').value = localStorage.getItem('evolutivo-anterior') || ''; } catch(e) {}
$('prev').addEventListener('input', () => { try { localStorage.setItem('evolutivo-anterior', $('prev').value); } catch(e) {} });
const CLR = {
  pres:['modal','punct','actitud','eCurso','eAsoc','eDirectriz','eSenso'],
  global:['global','mag','sinCambios'],
  sint:['sint','gOpen','sintLibre'],
  tareas:['tareaOn','tItems','tgOpen','tGrado','tRes','tMot','avOn','phAv'],
  interv:['interv','igOpen'],
  cierre:['riesgo','riesgoC','retiro']
};
document.querySelectorAll('.block h2 .clr').forEach(b => b.onclick = () => {
  const f = fresh(); CLR[b.dataset.clr].forEach(k => { st[k] = f[k]; });
  fillInputs(); sync();
});
$('ej1').onclick = () => load({
  global:'desfavorable', mag:'moderada', actitud:['colaboradora'], eCurso:'enlentecido', eDirectriz:'si',
  sint:[{name:'manifestaciones neurovegetativas', tend:'empeora', ctx:[]},{name:'retraimiento y aislamiento', tend:'empeora', ctx:[]}],
  tareaOn:true, tItems:['expo'], tGrado:'dificultad', tRes:'parciales',
  interv:[{id:'psico'},{id:'expo'}], igOpen:['Cognitivo-conductuales'],
  gOpen:[], modal:'presencial', punct:'horario', riesgo:'no', retiro:'estab'
});
$('ej2').onclick = () => load({
  global:'estable', sinCambios:true, actitud:['comunicativa','colaboradora'],
  interv:[{id:'cont'},{id:'logros'}],
  eCurso:'fluido', eAsoc:true, eDirectriz:'si', eSenso:'no', modal:'virtual', punct:'horario', avOn:true, phAv:['adherencia'], riesgo:'no', retiro:'tranq'
});

$('copy').onclick = async () => {
  const secs = ['Presentación en sesión','Descripción de la evolución de los síntomas','Intervenciones terapéuticas'];
  const text = [0,1,2].map(i => (st.edit[i]!==null ? st.edit[i] : gen[i]).trim()).filter(Boolean).join('\n\n');
  let ok = false;
  try { await navigator.clipboard.writeText(text); ok = true; } catch(e) {
    const ta = document.createElement('textarea'); ta.value = text; document.body.appendChild(ta); ta.select();
    try { ok = document.execCommand('copy'); } catch(_){} ta.remove();
  }
  $('toast').textContent = ok ? 'Evolutivo copiado' : 'No se pudo copiar: seleccioná el texto manualmente';
  setTimeout(()=>$('toast').textContent='', 2500);
};

load({});
})();
</script>
