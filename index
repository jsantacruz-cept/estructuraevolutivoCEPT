<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Evolutivo de psicoterapia · prototipo</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#EEF2F6; --surface:#FFFFFF; --ink:#16212E; --muted:#5A6676; --line:#D5DCE4;
  --srt:#1F4E8C; --srt-soft:#E3ECF7; --warn:#9A5B0C; --warn-soft:#FCEFD9; --ok:#2D7552; --ok-soft:#E1F1E8;
  --sel:#1F4E8C; --sel-ink:#FFFFFF;
  --ui:"Public Sans", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  --doc:"Source Serif 4", Georgia, "Times New Roman", serif;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#0F1620; --surface:#18212D; --ink:#E4EAF1; --muted:#9AA7B6; --line:#2C3847;
    --srt:#7EA8E0; --srt-soft:#1D2D44; --warn:#E8B062; --warn-soft:#3A2A12; --ok:#7CC9A0; --ok-soft:#173226;
    --sel:#7EA8E0; --sel-ink:#0F1620;
  }
}
:root[data-theme="dark"]{
  --bg:#0F1620; --surface:#18212D; --ink:#E4EAF1; --muted:#9AA7B6; --line:#2C3847;
  --srt:#7EA8E0; --srt-soft:#1D2D44; --warn:#E8B062; --warn-soft:#3A2A12; --ok:#7CC9A0; --ok-soft:#173226;
  --sel:#7EA8E0; --sel-ink:#0F1620;
}
*,*::before,*::after{box-sizing:inherit}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--ui);font-size:15px;line-height:1.5}
button,input,textarea,select{font:inherit;color:inherit}
:focus-visible{outline:2px solid var(--srt);outline-offset:2px}

header.top{max-width:1240px;margin:0 auto;padding:28px 20px 8px}
header.top h1{margin:0;font-size:1.6rem;font-weight:700;letter-spacing:-.01em}
header.top p{margin:6px 0 0;color:var(--muted);max-width:70ch}
.notice{display:inline-block;margin-top:12px;padding:6px 10px;border-radius:6px;background:var(--warn-soft);color:var(--warn);font-size:.88rem;font-weight:500}

.layout{max-width:1240px;margin:0 auto;padding:16px 20px 60px;display:grid;grid-template-columns:minmax(0,1fr) 440px;gap:24px;align-items:start}
@media (max-width:960px){.layout{grid-template-columns:1fr}}

.block{background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:18px 20px;margin-bottom:14px}
.block h2{margin:0 0 2px;font-size:1.05rem;font-weight:600}
.block .hint{margin:0 0 12px;color:var(--muted);font-size:.88rem}
.block .tag{font-size:.75rem;font-weight:600;color:var(--srt);background:var(--srt-soft);padding:2px 7px;border-radius:4px;margin-left:6px;vertical-align:2px}
.sub{font-size:.85rem;font-weight:600;color:var(--muted);margin:12px 0 6px}

.rules{border-style:dashed}
.rule{display:flex;gap:10px;align-items:flex-start;margin:8px 0;cursor:pointer}
.rule input{margin-top:4px;accent-color:var(--srt)}

.chips{display:flex;flex-wrap:wrap;gap:6px}
.chip{border:1px solid var(--line);background:transparent;border-radius:999px;padding:5px 12px;cursor:pointer;font-size:.9rem;line-height:1.3}
.chip:hover{border-color:var(--srt)}
.chip[aria-pressed="true"]{background:var(--sel);border-color:var(--sel);color:var(--sel-ink)}
.chip.support::after{content:" (apoyo)";opacity:.7;font-size:.8em}
.seg{display:inline-flex;border:1px solid var(--line);border-radius:8px;overflow:hidden}
.seg button{border:0;background:transparent;padding:7px 14px;cursor:pointer;border-right:1px solid var(--line)}
.seg button:last-child{border-right:0}
.seg button[aria-pressed="true"]{background:var(--sel);color:var(--sel-ink)}
.seg.small button{padding:4px 10px;font-size:.85rem}

.row{border-top:1px solid var(--line);padding:12px 0 4px;margin-top:10px}
.row:first-child{border-top:0;margin-top:0}
.row-head{display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:8px}
.row-head strong{font-weight:600}
.sgroup{border-top:1px solid var(--line);padding:6px 0}
.sgroup:first-child{border-top:0}
.sgroup > .toggle{font-weight:600}
.srow{display:flex;flex-wrap:wrap;align-items:center;gap:6px 10px;padding:5px 0 5px 24px}
.sname{flex:1 1 200px}
.srow .ctxs{flex-basis:100%;padding-top:4px;align-items:center}
.chip.gen{border-style:dashed}
.chip.gen[aria-pressed="true"]{border-style:solid}
.x{border:0;background:transparent;color:var(--muted);cursor:pointer;font-size:.85rem;text-decoration:underline}
.field{display:block;margin:8px 0}
.field span{display:block;font-size:.85rem;color:var(--muted);margin-bottom:3px}
input[type=text],textarea{width:100%;border:1px solid var(--line);border-radius:6px;padding:7px 10px;background:var(--bg)}
textarea{min-height:60px;resize:vertical}
.inline{display:flex;gap:8px}
.inline input{flex:1}
.addbtn{border:1px solid var(--line);background:transparent;border-radius:6px;padding:7px 12px;cursor:pointer}
.toggle{display:flex;gap:8px;align-items:center;cursor:pointer;margin:6px 0}
.toggle input{accent-color:var(--srt)}
.empty{color:var(--muted);font-size:.88rem;font-style:italic;margin:8px 0 0}
.hidden{display:none!important}

/* Vista previa tipo hoja de HC */
aside.preview{position:sticky;top:calc(16px + env(safe-area-inset-top,0px));max-height:calc(100vh - 32px - env(safe-area-inset-top,0px));overflow:auto}
.prev{background:var(--surface);border:1px solid var(--line);border-radius:10px;margin-bottom:14px}
.prev summary{padding:12px 18px;font-weight:600;cursor:pointer}
.prev .prev-body{padding:0 18px 14px}
.prev textarea{min-height:120px;font-family:var(--doc);font-size:.95rem;line-height:1.55}
.out{outline:none;border-radius:4px;min-height:1.6em}
.out:hover{background:var(--bg)}
.out:focus{background:var(--bg);box-shadow:0 0 0 2px var(--srt-soft)}
.out:empty::before{content:attr(data-empty);font-family:var(--ui);font-size:.85rem;color:var(--muted)}
.edtag{font-size:.72rem;font-weight:500;border:1px solid currentColor;border-radius:4px;padding:0 6px;opacity:.9}
.stale{font-family:var(--ui);font-size:.82rem;background:var(--warn-soft);color:var(--warn);border-radius:6px;padding:6px 10px;margin:4px 0 8px;display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.stale button{border:1px solid currentColor;background:transparent;color:inherit;border-radius:4px;padding:2px 8px;cursor:pointer;font-size:.8rem}
.edit-hint{font-family:var(--ui);font-size:.8rem;color:var(--muted);margin:10px 0 0}
@media (max-width:960px){
  .layout{display:flex;flex-direction:column}
  aside.preview{display:contents}
  .prev{order:-1;margin-bottom:0}
  .sheet{order:1}
}
.sheet{background:var(--surface);border:1px solid var(--line);border-radius:10px;overflow:hidden}
.sheet-top{padding:14px 18px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;gap:10px;align-items:baseline}
.sheet-top h2{margin:0;font-size:1rem}
.sheet-top small{color:var(--muted)}
.sheet-body{padding:6px 18px 16px;font-family:var(--doc);font-size:1rem;line-height:1.65}
.bar{background:var(--srt);color:#fff;font-family:var(--ui);font-size:.85rem;font-weight:600;padding:5px 10px;margin:14px -18px 8px;display:flex;justify-content:space-between;align-items:center;gap:8px}

.block h2{display:flex;align-items:center;gap:6px;flex-wrap:wrap}
.block h2 .clr{margin-left:auto;border:1px solid var(--line);background:transparent;color:var(--muted);border-radius:6px;padding:3px 10px;font-size:.8rem;font-weight:500;cursor:pointer}
.block h2 .clr:hover{color:var(--ink);border-color:var(--srt)}
.bar .clr{border:1px solid currentColor;background:transparent;color:inherit;border-radius:4px;padding:1px 8px;font-size:.78rem;font-weight:500;cursor:pointer;opacity:.9}
.bar .clr:hover{opacity:1}
:root[data-theme="dark"] .bar{color:#0F1620}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]) .bar{color:#0F1620}}
.sheet-body p{margin:0 0 6px;border-bottom:1px dotted var(--line);padding-bottom:6px}
mark{background:var(--warn-soft);color:var(--warn);font-family:var(--ui);font-size:.85em;padding:1px 4px;border-radius:3px}
.fixed-note{font-family:var(--ui);font-size:.82rem;color:var(--muted);margin-top:10px}
.status{padding:12px 18px;border-top:1px solid var(--line);font-size:.9rem}
.status.ok{background:var(--ok-soft);color:var(--ok)}
.status ul{margin:6px 0 0;padding-left:18px;color:var(--warn)}
.actions{display:flex;gap:8px;flex-wrap:wrap;padding:12px 18px;border-top:1px solid var(--line)}
.primary{background:var(--srt);color:#fff;border:0;border-radius:6px;padding:9px 16px;font-weight:600;cursor:pointer}
:root[data-theme="dark"] .primary{color:#0F1620}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]) .primary{color:#0F1620}}
.primary:disabled{opacity:.45;cursor:not-allowed}
.secondary{background:transparent;border:1px solid var(--line);border-radius:6px;padding:9px 14px;cursor:pointer}
.toast{font-size:.85rem;color:var(--ok);align-self:center}
@media (prefers-reduced-motion:no-preference){.chip,.seg button{transition:background .12s,border-color .12s}}
</style>
</head>
<body>

<header class="top">
  <h1>Evolutivo de psicoterapia</h1>
  <p>Carga estructurada para cumplir el formato SRT. Los datos del paciente salen de la cabecera de la historia clínica y los del profesional, de la firma: acá se cargan solo la evolución de los síntomas y las intervenciones.</p>
  <span class="notice">Prototipo de validación, se espera validación del equipo clínico.</span>
</header>

<div class="layout">
<main>

  <section class="block rules" aria-labelledby="h-rules">
    <h2 id="h-rules">Reglas de validación en prueba</h2>
    <p class="hint">Estas reglas están abiertas. Se pueden cambiar para comparar variantes con los profesionales.</p>
    <label class="rule"><input type="checkbox" id="r-estable" checked><span>Exigir al menos una intervención también cuando la evolución es estable</span></label>
    <label class="rule"><input type="checkbox" id="r-apoyo" checked><span>Aceptar “espacio de escucha” como intervención suficiente</span></label>
    <label class="rule"><input type="checkbox" id="r-present"><span>Exigir la presentación observada en sesión</span></label>
  </section>

  <section class="block" aria-labelledby="h2">
    <h2 id="h2">Presentación en sesión <span class="tag">Presentación en sesión</span><button type="button" class="clr" data-clr="pres">Borrar</button></h2>
    <p class="hint">Lo que observa el profesional, no lo que refiere el paciente.</p>
    <div class="sub">Modalidad</div>
    <div class="seg small" id="modal" role="group" aria-label="Modalidad"></div>
    <div class="sub">Horario</div>
    <div class="seg small" id="punct" role="group" aria-label="Horario"></div>
    <div class="sub">Actitud</div>
    <div class="chips" id="actitud"></div>
    <div class="sub">Estado</div>
    <div class="srow" style="padding-left:0"><span class="sname">Curso del pensamiento</span><div class="seg small" id="e-curso" role="group" aria-label="Curso del pensamiento"></div></div>
    <div class="srow" style="padding-left:0"><span class="sname">Asociación de ideas</span><div class="chips" id="e-asoc"></div></div>
    <div class="srow" style="padding-left:0"><span class="sname">Sostiene la idea directriz</span><div class="seg small" id="e-directriz" role="group" aria-label="Sostiene la idea directriz"></div></div>
    <div class="srow" style="padding-left:0"><span class="sname">Alteraciones en la sensopercepción</span><div class="seg small" id="e-senso" role="group" aria-label="Alteraciones en la sensopercepción"></div></div>
  </section>

  <section class="block" aria-labelledby="h1">
    <h2 id="h1">Estado global <span class="tag">Evolución de los síntomas</span><button type="button" class="clr" data-clr="global">Borrar</button></h2>
    <p class="hint">Opcional. Comparación con el encuentro anterior.</p>
    <div class="seg" id="global" role="group" aria-label="Estado global"></div>
    <div id="mag-wrap" class="hidden">
      <div class="sub">Magnitud</div>
      <div class="seg small" id="mag" role="group" aria-label="Magnitud"></div>
    </div>
    <label class="toggle hidden" id="sc-wrap"><input type="checkbox" id="sin-cambios"> Sin cambios clínicos significativos desde el encuentro anterior</label>
  </section>

  <section class="block" aria-labelledby="h3">
    <h2 id="h3">Síntomas referidos <span class="tag">Evolución de los síntomas</span><button type="button" class="clr" data-clr="sint">Borrar</button></h2>
    <p class="hint">Marcá los grupos de síntomas que presenta el paciente. En cada síntoma, un toque indica cómo evolucionó.</p>
    <div id="sint-cat"></div>
    <div class="inline" style="margin-top:10px">
      <input type="text" id="sint-otro" placeholder="Otro síntoma" aria-label="Otro síntoma">
      <button class="addbtn" id="sint-add">Agregar</button>
    </div>
    <div id="sint-rows" style="margin-top:8px"></div>
    <label class="field"><span>Observaciones (opcional)</span><textarea id="sint-libre"></textarea></label>
  </section>

  <section class="block" aria-labelledby="h4">
    <h2 id="h4">Tareas pactadas y avances <span class="tag">Intervenciones</span><button type="button" class="clr" data-clr="tareas">Borrar</button></h2>
    <p class="hint">Opcional. Si no se completa, no aparece en el texto.</p>
    <label class="toggle"><input type="checkbox" id="tarea-on"> Había una tarea pactada desde el encuentro anterior</label>
    <div id="tarea-box" class="hidden">
      <div id="t-cat"></div>
      <div class="sub">Cumplimiento</div>
      <div class="seg small" id="t-grado" role="group" aria-label="Cumplimiento"></div>
      <div id="t-res-wrap">
        <div class="sub">Resultado</div>
        <div class="seg small" id="t-res" role="group" aria-label="Resultado"></div>
      </div>
      <label class="field hidden" id="t-mot-wrap"><span>Motivo referido (opcional)</span><input type="text" id="t-mot"></label>
    </div>
    <label class="toggle"><input type="checkbox" id="av-on"> Avances generales <span class="tag">Evolución de los síntomas</span></label>
    <div id="av-box" class="hidden" style="padding-left:24px">
      <div class="chips" id="ph-av"></div>
    </div>
  </section>

  <section class="block" aria-labelledby="h5">
    <h2 id="h5">Intervenciones en sesión <span class="tag">Intervenciones</span><button type="button" class="clr" data-clr="interv">Borrar</button></h2>
    <p class="hint">Marcá los grupos de intervenciones que usaste y elegí las que correspondan.</p>
    <div id="int-cat"></div>
  </section>

  <section class="block" aria-labelledby="h7">
    <h2 id="h7">Cierre de la consulta <span class="tag">Intervenciones</span><button type="button" class="clr" data-clr="cierre">Borrar</button></h2>
    <p class="hint">Opcional. No tiene ninguna opción preseleccionada: si no se marca, no aparece en el texto.</p>
    <div class="sub">Evaluación de riesgo</div>
    <div class="seg small" id="riesgo" role="group" aria-label="Evaluación de riesgo"></div>
    <label class="field hidden" id="riesgo-c-wrap"><span>Conducta adoptada</span><input type="text" id="riesgo-c" placeholder="p. ej., se da aviso a la coordinación y se solicita interconsulta con Psiquiatría"></label>
    <div class="sub">Cómo se retira</div>
    <div class="chips" id="ph-retiro"></div>
  </section>

</main>

<aside class="preview" aria-labelledby="h-prev">
  <details class="prev" open>
    <summary>Evolutivo anterior</summary>
    <div class="prev-body">
      <textarea id="prev" aria-label="Evolutivo anterior" placeholder="Pegá acá el evolutivo de la consulta anterior para tenerlo como referencia mientras cargás el nuevo."></textarea>
    </div>
  </details>
  <div class="sheet">
    <div class="sheet-top"><h2 id="h-prev">Evolutivo generado</h2><small>Vista como en la HC</small></div>
    <div class="sheet-body">
      <div id="sec0"><div class="bar"><span>Presentación en sesión</span><span class="edtag hidden" id="ed0">Editado</span></div>
      <div class="stale hidden" id="stale0"></div>
      <div class="out" id="out0" contenteditable="true" data-empty="Sin datos cargados en Presentación en sesión."></div></div>
      <div class="bar"><span>Descripción de la evolución de los síntomas</span><span class="edtag hidden" id="ed1">Editado</span></div>
      <div class="stale hidden" id="stale1"></div>
      <div class="out" id="out1" contenteditable="true" data-empty=""></div>
      <div class="bar"><span>Intervenciones terapéuticas</span><span class="edtag hidden" id="ed2">Editado</span></div>
      <div class="stale hidden" id="stale2"></div>
      <div class="out" id="out2" contenteditable="true" data-empty=""></div>
      <p class="edit-hint">El texto se puede editar antes de copiarlo.</p>
    </div>
    <div class="status" id="status" aria-live="polite"></div>
    <div class="actions">
      <button class="primary" id="copy">Copiar evolutivo</button>
      <button class="secondary" id="reroll">Otra redacción</button>
      <button class="secondary" id="restore">Restaurar texto generado</button>
      <button class="secondary" id="ej1">Ejemplo: desfavorable</button>
      <button class="secondary" id="ej2">Ejemplo: estable</button>
      <button class="secondary" id="reset">Empezar de nuevo</button>
      <span class="toast" id="toast" aria-live="polite"></span>
    </div>
  </div>
</aside>
</div>

<script>
(function(){
const $ = id => document.getElementById(id);
const esc = s => String(s).replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const cap = s => s.charAt(0).toUpperCase() + s.slice(1);
const M = label => '\u0001' + label + '\u0002';            // marcador de dato faltante
const joinY = arr => {
  if (arr.length === 0) return '';
  if (arr.length === 1) return arr[0];
  const last = arr[arr.length-1];
  const plain = last.replace(/[\u0001\u0002]/g,'').toLowerCase();
  const conj = (/^h?i/.test(plain) && !/^hie/.test(plain)) ? ' e ' : ' y ';
  return arr.slice(0,-1).join(', ') + conj + last;
};

/* Catálogos de ejemplo */
const GLOBAL = [['favorable','Favorable'],['estable','Estable'],['desfavorable','Desfavorable']];
const MAG = [['leve','Leve'],['moderada','Moderada'],['marcada','Marcada']];
const ACTITUD = [{id:'comunicativa',label:'Comunicativa'},{id:'colaboradora',label:'Colaboradora'},{id:'poco colaboradora',label:'Poca colaboración'},
  {id:'participativa',label:'Participativa'},{id:'reticente',label:'Reticente'},{id:'demandante',label:'Demandante'},{id:'querellante',label:'Querellante'}];
const E_CURSO = [['fluido','Fluido'],['disgregado','Disgregado'],['enlentecido','Enlentecido']];
const E_SINO = [['si','Sí'],['no','No']];
const ESTADO_V = {
  'curso:fluido':['Curso del pensamiento fluido.','Pensamiento de curso fluido.','Se observa un curso de pensamiento fluido.'],
  'curso:disgregado':['Curso del pensamiento disgregado.','Pensamiento de curso disgregado.','Se observa un curso de pensamiento disgregado.'],
  'curso:enlentecido':['Curso del pensamiento enlentecido.','Pensamiento de curso enlentecido.','Se observa un curso de pensamiento enlentecido.'],
  'asoc':['Asociación coherente de ideas.','Ideas asociadas de manera coherente.','Asocia las ideas de manera coherente.'],
  'directriz:si':['Sostiene la idea directriz.','Mantiene la idea directriz del discurso.','Logra sostener la idea directriz.'],
  'directriz:no':['No sostiene la idea directriz.','Con dificultad para sostener la idea directriz.','Pierde la idea directriz del discurso.'],
  'senso:si':['Presenta alteraciones en la sensopercepción.','Se evidencian alteraciones sensoperceptivas.','Alteraciones en la sensopercepción presentes.'],
  'senso:no':['Sin alteraciones en la sensopercepción.','No presenta alteraciones sensoperceptivas.','Sensopercepción sin alteraciones.']
};
const MODAL = [['presencial','Presencial'],['virtual','Virtual']];
const PUNCT = [['horario','En horario'],['antes','Antes de lo acordado'],['fuera','Fuera de horario']];
const ASIST_V = {
  'presencial:horario':['Asiste según lo acordado.','Se presenta en el horario pautado.','Concurre a la consulta en el horario acordado.'],
  'presencial:antes':['Asiste antes del horario acordado.','Se presenta antes del horario pautado.','Concurre a la consulta antes de lo acordado.'],
  'presencial:fuera':['Asiste fuera del horario pautado.','Se presenta fuera del horario acordado.','Concurre a la consulta fuera del horario pautado.'],
  'virtual:horario':['Se conecta a la consulta virtual en el horario pautado.','Asiste a la consulta virtual según lo acordado.','Consulta en modalidad virtual; se conecta en horario.'],
  'virtual:antes':['Se conecta a la consulta virtual antes del horario pautado.','Consulta en modalidad virtual; se conecta antes de lo acordado.'],
  'virtual:fuera':['Se conecta a la consulta virtual fuera del horario pautado.','Consulta en modalidad virtual; se conecta fuera del horario acordado.'],
  'presencial:':['Consulta presencial.','Atención en modalidad presencial.'],
  'virtual:':['Consulta en modalidad virtual.','Atención en modalidad virtual.']
};
['horario','antes','fuera'].forEach(p => ASIST_V[':'+p] = ASIST_V['presencial:'+p]);
